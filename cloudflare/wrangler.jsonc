// Production Worker for https://servicecaptureco.com.
// Serves the static export in ../production and the same-origin /api/review
// inquiry endpoint. Deploy from agency-source with `npm run deploy:site`.
{
  "$schema": "../agency-source/node_modules/wrangler/config-schema.json",
  "name": "service-capture-co",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  // One public origin only: no *.workers.dev or preview copies of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../production",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Every request passes through the Worker so redirects and security
    // headers apply to static pages too.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "servicecaptureco.com", "custom_domain": true },
    { "pattern": "www.servicecaptureco.com", "custom_domain": true }
  ],
  "vars": {
    "CANONICAL_ORIGIN": "https://servicecaptureco.com",
    // Server-side only; never shipped to the browser.
    "INQUIRY_TO": "ahmedali@servicecaptureco.com",
    "INQUIRY_FROM": "Service Capture Co. Website <hello@servicecaptureco.com>",
    // Switch to "on" only after HTTPS is confirmed on the custom domain.
    "HSTS": "off"
  },
  // RESEND_API_KEY is a secret: set it in the Cloudflare dashboard or with
  // `wrangler secret put RESEND_API_KEY`, never in this file.
  "ratelimits": [
    { "name": "REVIEW_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
